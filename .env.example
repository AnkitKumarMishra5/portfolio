# ─────────── Required in production ───────────
# Only for the /admin usage dashboard. The site builds and runs without them.

# Opens /admin?token=... Long and random.
ADMIN_TOKEN=

# Keys visitor pseudonyms. Long and random; rotating it makes every visitor new.
ANALYTICS_ID_SECRET=

# Event storage. The Upstash Redis integration on Vercel injects both.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ─────────── Optional ───────────

# Live "Ask the page" assistant. Falls back to a canned reply without it.
OPENAI_API_KEY=

# Defaults to gpt-4o-mini.
OPENAI_MODEL=

# Canonical origin. Inferred on Vercel; set it on any other host.
NEXT_PUBLIC_SITE_URL=

# Search console ownership: the content value of the meta tag, not the tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# 8 to 128 hex characters, your choice. Used by `npm run indexnow`.
INDEXNOW_KEY=

# Redis list name. Defaults to akm:events.
ANALYTICS_REDIS_KEY=

# "off" disables all collection.
NEXT_PUBLIC_ANALYTICS=

# "1" stores a random id in localStorage so returning browsers are recognised.
NEXT_PUBLIC_ANALYTICS_PERSISTENT_ID=
