# Live "Ask the page" assistant. Without this the section still works and
# returns a graceful fallback message instead of a model answer.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# Canonical origin for metadata, Open Graph, JSON-LD, sitemap and robots.
# On Vercel this is inferred automatically. Set it for any other host.
NEXT_PUBLIC_SITE_URL=

# Google Search Console ownership check. Paste ONLY the content value from the
# "HTML tag" verification method, not the whole <meta> tag. Not a secret.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools ownership check, same idea: the content value of the
# msvalidate.01 meta tag. Not a secret.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# IndexNow key (8 to 128 hex characters, make one up). Set here AND on the
# deployment; `npm run indexnow` pings Bing, Yandex, Naver and Seznam after a deploy.
INDEXNOW_KEY=

# ---------------------------------------------------------------------------
# Usage dashboard at /admin?token=...
# ---------------------------------------------------------------------------

# Required in production to open the dashboard.
ADMIN_TOKEN=

# Keys visitor pseudonyms. Long and random; rotating it makes every visitor new.
ANALYTICS_ID_SECRET=

# Where events are kept. Add the Upstash Redis integration in the Vercel dashboard
# and it injects these for you (older projects get KV_REST_API_URL / _TOKEN, also
# accepted). Unset, events live in process memory: fine locally, lost on redeploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional. The Redis list name. Defaults to akm:events.
ANALYTICS_REDIS_KEY=

# "off" disables all collection. Anything else leaves it on.
NEXT_PUBLIC_ANALYTICS=

# "1" keeps a random id in the visitor's localStorage so the same browser is
# recognised across days.
NEXT_PUBLIC_ANALYTICS_PERSISTENT_ID=
